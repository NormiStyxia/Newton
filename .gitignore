# UrhoX project source is tracked; generated output and local runtime state are not.

# Build and preview output
.build/
dist/
.cli/
logs/
.tmp/
.agent/
_uploads/
*.log

# Project-generated upload/build cache
.project/.build/
.project/**/*.meta

# Engine-generated resource metadata
*.meta

# Local asset upload/cache files
.ossutil_checkpoint/
ossutil_output/

# Local editor, SDK, and agent configuration
.vscode/
.claude/
.codex/
.cursor/
.gemini/
.emmylua/
.installer/
.maker/

# Bundled engine documentation, examples, schemas, templates, and libraries
engine-docs/
examples/
lua-tools/
schemas/
skills/
templates/
tools/
urhox-libs/

# OS and editor temporary files
.DS_Store
Thumbs.db
*~
*.swp
*.swo

# Python caches
__pycache__/
*.py[cod]
.pytest_cache/

# Node/package-manager caches if local tooling creates them
node_modules/
.npm/
